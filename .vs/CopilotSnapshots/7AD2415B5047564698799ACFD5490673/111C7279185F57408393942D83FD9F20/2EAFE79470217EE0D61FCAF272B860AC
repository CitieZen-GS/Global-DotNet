using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Enums;
using System.Net;
using System.Net.Http.Json;
using Xunit;

namespace Ajudante_Familiar_Global.integrationTests.Integration
{
    internal static class IntegrationTestData
    {
        public static async Task<T> CriarAsync<T>(HttpClient client, string rota, object dados)
        {
            var response = await client.PostAsJsonAsync(rota, dados);

            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi criado por: {erro}");
            }

            Assert.Equal(HttpStatusCode.Created, response.StatusCode);

            var entidade = await response.Content.ReadFromJsonAsync<T>();
            Assert.NotNull(entidade);
            return entidade!;
        }

        public static Task<Cargo> CriarCargoAsync(HttpClient client)
        {
            return CriarAsync<Cargo>(client, "api/Cargo/cargo/criar", new
            {
                Nm_cargo = $"cargo-{Guid.NewGuid():N}"[..20],
                Fg_permissao = Permissao.S
            });
        }

        public static async Task<Perfil> CriarPerfilAsync(HttpClient client)
        {
            var cargo = await CriarCargoAsync(client);
            return await CriarAsync<Perfil>(client, "api/Perfil/perfil/criar", new
            {
                nm_perfil = $"perfil-{Guid.NewGuid():N}"[..20],
                id_cargo = cargo.Id_cargo
            });
        }

        public static async Task<Cuidador> CriarCuidadorAsync(HttpClient client)
        {
            var perfil = await CriarPerfilAsync(client);
            var identificador = Guid.NewGuid().ToString("N");
            return await CriarAsync<Cuidador>(client, "api/Cuidador/cuidador/criar", new
            {
                Nm_cuidador = $"cuidador-{identificador}"[..20],
                Cpf_cuidador = identificador[..11],
                Ds_email = $"a{identificador[..8]}@x.co",
                Ds_senha = "senha123",
                Id_perfil = perfil.id_perfil
            });
        }

        public static async Task<Idoso> CriarIdosoAsync(HttpClient client)
        {
            var cuidador = await CriarCuidadorAsync(client);
            var identificador = Guid.NewGuid().ToString("N");
            return await CriarAsync<Idoso>(client, "api/Idoso/idoso/criar", new
            {
                Nm_idoso = $"idoso-{identificador}"[..20],
                cpf_idoso = identificador[..11],
                vlr_altura = 1.70m,
                vlr_peso = 70m,
                dt_nascimento = new DateOnly(1950, 1, 1),
                ds_comportamento = "Teste de integração",
                id_cuidador = cuidador.Id_cuidador
            });
        }

        public static async Task<Lembrete_Consulta> CriarLembreteConsultaAsync(HttpClient client)
        {
            var idoso = await CriarIdosoAsync(client);
            return await CriarAsync<Lembrete_Consulta>(client, "api/Lembrete_Consulta/lembrete_consulta/criar", new
            {
                Ds_titulo_lembrente_consulta = "Consulta teste",
                Nm_consulta_medico = "Medico teste",
                Dt_consulta = new DateTime(2026, 8, 9),
                Hr_consulta = new DateTime(2026, 8, 9, 9, 0, 0),
                Ds_consulta = "Consulta de integração",
                St_consulta = Status.Pendente,
                Id_idoso = idoso.ID_idoso
            });
        }

        public static async Task<Medicamentos> CriarMedicamentoAsync(HttpClient client)
        {
            var idoso = await CriarIdosoAsync(client);
            return await CriarAsync<Medicamentos>(client, "api/Medicamentos/medicamentos/criar", new
            {
                Nm_medicamentos = "Medicamento teste",
                Via_administracao = "Oral",
                Vl_frquencia = "Uma vez ao dia",
                Ds_instrucao_uso = "Após refeição",
                Dt_medicamento = new DateTime(2026, 8, 9),
                Hr_medicamento = new DateTime(2026, 8, 9, 9, 0, 0),
                Id_idoso = idoso.ID_idoso
            });
        }
    }
}
