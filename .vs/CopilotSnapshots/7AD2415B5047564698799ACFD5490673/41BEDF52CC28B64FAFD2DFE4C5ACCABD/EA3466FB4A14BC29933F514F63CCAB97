using Ajudante_Familiar_Global.integrationTests.FactoryFixture;
using Ajudante_Familiar_Global.Domain.Entities;
using System;
using System.Net;
using System.Net.Http.Json;
using Xunit;

namespace Ajudante_Familiar_Global.integrationTests.Integration
{
    //Atenção!!! Tanto o create quanto o update precisam ter cuidado com os dados que serão adicionados, porque, se não, pode dar erro.
    //Recomendação faz um a cada vez, não faz eles tudo junto
    [Collection("ApiCollection")]
    public class IdosoControllerIntegrationTests
    {
        private readonly HttpClient _client;

        public IdosoControllerIntegrationTests(ApiFactoryFixture factory)
        {
            _client = factory.CreateClient();
        }

        private async Task<Idoso> CriarIdosoAsync()
        {
            // Arrange
            var cuidador = await IntegrationTestData.CriarCuidadorAsync(_client);
            var identificador = Guid.NewGuid().ToString("N");
            var novoIdoso = new
            {
                Nm_idoso = $"idoso-{identificador}"[..20],
                cpf_idoso = identificador[..11],
                vlr_altura = 1.70m,
                vlr_peso = 70m,
                dt_nascimento = new DateOnly(1950, 1, 1),
                ds_comportamento = "Teste de integração",
                id_cuidador = cuidador.Id_cuidador
            };

            // Act
            var response = await _client.PostAsJsonAsync("api/Idoso/idoso/criar", novoIdoso);

            // Assert
            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi criado o idoso: {erro}");
            }

            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
            var idoso = await response.Content.ReadFromJsonAsync<Idoso>();
            Assert.NotNull(idoso);
            return idoso!;
        }

        [Fact]
        public async Task CriarIdoso_DadosValidos_RetornaOk()
        {
            // Act
            var idosoCriado = await CriarIdosoAsync();

            // Assert
            Assert.True(idosoCriado.ID_idoso > 0);
            Assert.StartsWith("idoso-", idosoCriado.Nm_idoso);
            Assert.True(idosoCriado.id_cuidador > 0);
        }

        [Fact]
        public async Task AtualizarIdoso_DadosValidos_RetornaSucesso()
        {
            // Arrange
            var idosoExistente = await CriarIdosoAsync();
            var idosoAtualizado = new
            {
                Nm_idoso = "Idoso atualizado",
                cpf_idoso = Guid.NewGuid().ToString("N")[..11],
                vlr_altura = 1.72m,
                vlr_peso = 72m,
                dt_nascimento = new DateOnly(1951, 2, 2),
                ds_comportamento = "Atualizado",
                id_cuidador = idosoExistente.id_cuidador
            };

            // Act
            var response = await _client.PutAsJsonAsync(
                $"api/Idoso/idoso/atualiza/{idosoExistente.ID_idoso}", idosoAtualizado);

            // Assert
            var responseBody = await response.Content.ReadAsStringAsync();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var idoso = await response.Content.ReadFromJsonAsync<Idoso>();
            Assert.True(idoso is not null, $"Resposta sem idoso: {responseBody}");
            Assert.Equal("Idoso atualizado", idoso!.Nm_idoso);
            Assert.Equal(72m, idoso.vlr_peso);
        }

        [Fact]
        public async Task GetIdoso_dados_RetornaOk()
        {
            // Arrange
            var idosoCriado = await CriarIdosoAsync();

            // Act
            var response = await _client.GetAsync($"api/Idoso/idoso/{idosoCriado.ID_idoso}");

            // Assert
            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                Assert.Fail("Idoso não encontrado");
            }
            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);

            var idoso = await response.Content.ReadFromJsonAsync<Idoso>();
            Assert.NotNull(idoso);
            Assert.Equal(idosoCriado.ID_idoso, idoso.ID_idoso);
        }

        [Fact]
        public async Task GetAllIdoso_dados_RetornarOk()
        {
            // Arrange
            var idosoCriado = await CriarIdosoAsync();

            // Act
            var response = await _client.GetAsync("api/Idoso/idoso");

            // Assert
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var idosos = await response.Content.ReadFromJsonAsync<List<Idoso>>();
            Assert.NotNull(idosos);
            Assert.Contains(idosos, idoso => idoso.ID_idoso == idosoCriado.ID_idoso);
        }

        [Fact]
        public async Task DeleteIdoso_dados_RetornaOk()
        {
            // Arrange
            var idosoCriado = await CriarIdosoAsync();

            // Act
            var response = await _client.DeleteAsync(
                $"api/Idoso/idoso/deleta/{idosoCriado.ID_idoso}");

            // Assert
            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi deletado o idoso: {erro}");
            }
            Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);

            var consultaResponse = await _client.GetAsync(
                $"api/Idoso/idoso/{idosoCriado.ID_idoso}");
            Assert.Equal(HttpStatusCode.NotFound, consultaResponse.StatusCode);
        }
    }
}
