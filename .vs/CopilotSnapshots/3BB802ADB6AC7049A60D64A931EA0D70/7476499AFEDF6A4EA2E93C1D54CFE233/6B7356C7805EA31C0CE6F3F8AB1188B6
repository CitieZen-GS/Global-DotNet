using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Interfaces.IService;
using Microsoft.AspNetCore.Mvc;

namespace Ajudante_Familiar_Global.Controllers
{
    [ApiController]
    [Route("api/[controller]")]
    [Produces("application/json")]
    public class ParenteController : ControllerBase
    {
        private readonly IParenteService _ParenteService;
        private readonly ILogger<ParenteController> _logger;

        public ParenteController(IParenteService parenteService, ILogger<ParenteController> logger)
        {
            _ParenteService = parenteService;
            _logger = logger;
        }

        /// <summary>
        /// Carregar todos os parentes presentes no banco
        /// </summary>
        /// <response code="200">Busca feita com sucesso</response>
        /// <response code="500">Erro interno do servidor</response>
        /// <returns>Lista de parentes</returns>
        [HttpGet]
        [Route("[controller]/parente")]
        [ProducesResponseType(typeof(IEnumerable<Parente>), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status500InternalServerError)]
        public async Task<ActionResult<IEnumerable<Parente>>> GetAllParente()
        {
            try
            {
                var relatorioParente = await _ParenteService.GetAllParenteAsync();
                return Ok(relatorioParente);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erro ao buscar todos os parentes");
                return StatusCode(500, new { mensagem = "Erro interno do servidor" });
            }
        }

        /// <summary>
        /// Carregar o parente por meio do id
        /// </summary>
        /// <response code="200">Busca feita com sucesso</response>
        /// <response code="404">Id não encontrado</response>
        /// <param name="id_parente">Id do parente</param>
        /// <returns>Parente encontrado</returns>
        [HttpGet]
        [Route("[controller]/parente/{id_parente:int}")]
        [ProducesResponseType(typeof(Parente), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Parente>> GetParente(int id_parente)
        {
            try
            {
                var parente = await _ParenteService.GetParenteAsync(id_parente);
                return Ok(parente);
            }
            catch (KeyNotFoundException ex)
            {
                _logger.LogWarning("Parente {Id} não encontrado", id_parente);
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Criação de parente
        /// </summary>
        /// <param name="parente">Dados do novo parente</param>
        /// <response code="201">Parente criado com sucesso</response>
        /// <response code="400">Erro na validação</response>
        /// <response code="404">Idoso ou perfil não encontrado</response>
        /// <returns>Parente criado</returns>
        [HttpPost]
        [Route("[controller]/parente/criar")]
        [ProducesResponseType(typeof(Parente), StatusCodes.Status201Created)]
        [ProducesResponseType(StatusCodes.Status400BadRequest)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Parente>> PostParente([FromBody] Parente parente)
        {
            try
            {
                var criado = await _ParenteService.CreateParenteAsync(parente);
                return CreatedAtAction(nameof(GetParente), new { id_parente = criado.Id_parente }, criado);
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Atualizar dados do parente
        /// </summary>
        /// <param name="id_parente">Id do parente na URL</param>
        /// <param name="parente">Novos dados do parente</param>
        /// <response code="200">Parente atualizado</response>
        /// <response code="400">Erro na requisição</response>
        /// <response code="404">Parente, idoso ou perfil não encontrado</response>
        /// <returns>Parente atualizado</returns>
        [HttpPut]
        [Route("[controller]/parente/atualiza/{id_parente:int}")]
        [ProducesResponseType(typeof(Parente), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status400BadRequest)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Parente>> PutParente(int id_parente, [FromBody] Parente parente)
        {
            try
            {
                var atualizada = await _ParenteService.UpdateParenteAsync(id_parente, parente);
                return Ok(atualizada);
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Remove um parente do sistema pelo seu id
        /// </summary>
        /// <param name="id_parente">Id do parente a ser deletado</param>
        /// <response code="204">Parente removido com sucesso</response>
        /// <response code="404">Parente não encontrado</response>
        [HttpDelete]
        [Route("[controller]/parente/deleta/{id_parente:int}")]
        [ProducesResponseType(StatusCodes.Status204NoContent)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<IActionResult> DeleteParente(int id_parente)
        {
            try
            {
                await _ParenteService.DeleteParenteAsync(id_parente);
                return NoContent();
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }
    }
}
