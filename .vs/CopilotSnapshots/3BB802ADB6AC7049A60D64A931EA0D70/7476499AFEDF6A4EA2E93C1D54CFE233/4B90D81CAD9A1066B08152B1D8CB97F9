using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Interfaces.IService;
using Microsoft.AspNetCore.Mvc;

namespace Ajudante_Familiar_Global.Controllers
{
    [ApiController]
    [Route("api")]
    [Produces("application/json")]
    public class PerfilController : ControllerBase
    {
        private readonly IPerfilService _PerfilService;
        private readonly ILogger<PerfilController> _logger;

        public PerfilController(IPerfilService perfilService, ILogger<PerfilController> logger)
        {
            _PerfilService = perfilService;
            _logger = logger;
        }

        /// <summary>
        /// Carregar todos os perfis presentes no banco
        /// </summary>
        /// <response code="200">Busca feita com sucesso</response>
        /// <response code="500">Erro interno do servidor</response>
        /// <returns>Lista de perfis</returns>
        [HttpGet]
        [Route("[controller]/perfil")]
        [ProducesResponseType(typeof(IEnumerable<Perfil>), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status500InternalServerError)]
        public async Task<ActionResult<IEnumerable<Perfil>>> GetAllPerfil()
        {
            try
            {
                var relatorioPerfil = await _PerfilService.GetAllPerfilAsync();
                return Ok(relatorioPerfil);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Erro ao buscar todos os perfis");
                return StatusCode(500, new { mensagem = "Erro interno do servidor" });
            }
        }

        /// <summary>
        /// Carregar o perfil por meio do id
        /// </summary>
        /// <response code="200">Busca feita com sucesso</response>
        /// <response code="404">Id não encontrado</response>
        /// <param name="id_perfil">Id do perfil</param>
        /// <returns>Perfil encontrado</returns>
        [HttpGet]
        [Route("[controller]/perfil/{id_perfil:int}")]
        [ProducesResponseType(typeof(Perfil), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Perfil>> GetPerfil(int id_perfil)
        {
            try
            {
                var perfil = await _PerfilService.GetPerfilAsync(id_perfil);
                return Ok(perfil);
            }
            catch (KeyNotFoundException ex)
            {
                _logger.LogWarning("Perfil {Id} não encontrado", id_perfil);
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Criação de perfil
        /// </summary>
        /// <param name="perfil">Dados do novo perfil</param>
        /// <response code="201">Perfil criado com sucesso</response>
        /// <response code="400">Erro na validação</response>
        /// <response code="404">Cargo não encontrado</response>
        /// <returns>Perfil criado</returns>
        [HttpPost]
        [Route("[controller]/perfil/criar")]
        [ProducesResponseType(typeof(Perfil), StatusCodes.Status201Created)]
        [ProducesResponseType(StatusCodes.Status400BadRequest)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Perfil>> PostPerfil([FromBody] Perfil perfil)
        {
            try
            {
                var criado = await _PerfilService.CreatePerfilAsync(perfil);
                return CreatedAtAction(nameof(GetPerfil), new { id_perfil = criado.id_perfil }, criado);
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Atualizar dados do perfil
        /// </summary>
        /// <param name="id_perfil">Id do perfil na URL</param>
        /// <param name="perfil">Novos dados do perfil</param>
        /// <response code="200">Perfil atualizado</response>
        /// <response code="400">Erro na requisição</response>
        /// <response code="404">Perfil ou cargo não encontrado</response>
        /// <returns>Perfil atualizado</returns>
        [HttpPut]
        [Route("[controller]/perfil/atualiza/{id_perfil:int}")]
        [ProducesResponseType(typeof(Perfil), StatusCodes.Status200OK)]
        [ProducesResponseType(StatusCodes.Status400BadRequest)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<ActionResult<Perfil>> PutPerfil(int id_perfil, [FromBody] Perfil perfil)
        {
            try
            {
                var atualizada = await _PerfilService.UpdatePerfilAsync(id_perfil, perfil);
                return Ok(atualizada);
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }

        /// <summary>
        /// Remove um perfil do sistema pelo seu id
        /// </summary>
        /// <param name="id_perfil">Id do perfil a ser deletado</param>
        /// <response code="204">Perfil removido com sucesso</response>
        /// <response code="404">Perfil não encontrado</response>
        [HttpDelete]
        [Route("[controller]/perfil/deleta/{id_perfil:int}")]
        [ProducesResponseType(StatusCodes.Status204NoContent)]
        [ProducesResponseType(StatusCodes.Status404NotFound)]
        public async Task<IActionResult> DeletePerfil(int id_perfil)
        {
            try
            {
                await _PerfilService.DeletePerfilAsync(id_perfil);
                return NoContent();
            }
            catch (KeyNotFoundException ex)
            {
                return NotFound(new { mensagem = ex.Message });
            }
        }
    }
}
