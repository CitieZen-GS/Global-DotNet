using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Interfaces;
using Ajudante_Familiar_Global.Infrastruture.Data;
using Microsoft.EntityFrameworkCore;

namespace Ajudante_Familiar_Global.Infrastruture.Repository
{
    public class DoencasRepository : IDoencasRepository
    {
        private readonly AppDbContext _context;

        public DoencasRepository(AppDbContext context)
        {
            _context = context;
        }

        public async Task<Doencas> CreateDoencasAsync(Doencas doencas)
        {
            await _context.Doencas.AddAsync(doencas);
            await _context.SaveChangesAsync();
            return doencas;
        }

        public async Task<Doencas> DeleteDoencasAsync(int id_doenca)
        {
            var doencas = await _context.Doencas.FindAsync(id_doenca);
            if (doencas == null)
            {
                throw new KeyNotFoundException($"Id doença com id {id_doenca} não foi encontrado");
            }
            _context.Doencas.Remove(doencas);
            await _context.SaveChangesAsync();
            return doencas;
        }

        public async Task<Doencas> GetDoencasAsync(int id_doenca)
        {
            var existeDoencas = await _context.Doencas.FindAsync(id_doenca);
            if (existeDoencas == null)
            {
                throw new KeyNotFoundException($"Doença com id {id_doenca} não encontrada.");
            }
            return existeDoencas;
        }

        public async Task<IEnumerable<Doencas>> GetAllDoencasAsync()
        {
            return await _context.Doencas.ToListAsync();
        }

        public async Task<Doencas> UpdateDoencasAsync(int id_doenca, Doencas doencas)
        {
            var existeDoencas = await _context.Doencas.FindAsync(id_doenca);
            if (existeDoencas == null)
            {
                throw new KeyNotFoundException($"Doença com id {id_doenca} não foi encontrada.");
            }

            existeDoencas.Nm_doenca = doencas.Nm_doenca;
            existeDoencas.Ds_doenca = doencas.Ds_doenca;
            existeDoencas.Id_idoso = doencas.Id_idoso;

            await _context.SaveChangesAsync();

            return existeDoencas;
        }
    }
}
