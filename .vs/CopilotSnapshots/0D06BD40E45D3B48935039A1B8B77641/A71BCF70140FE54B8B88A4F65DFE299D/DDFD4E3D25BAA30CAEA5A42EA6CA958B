        [Fact]
        public async Task CreateAlimentacao_DadosValidos_RetornaOk()
        {
            // Arrange
            var id_cargo = Random.Shared.Next(100000, int.MaxValue);
            var id_perfil = Random.Shared.Next(100000, int.MaxValue);
            var id_cuidador = Random.Shared.Next(100000, int.MaxValue);
            var id_idoso = Random.Shared.Next(100000, int.MaxValue);
            var id_alimentacao = Random.Shared.Next(100000, int.MaxValue);

            var cargo = new Cargo(id_cargo, "Cargo teste", Permissao.N);
            var perfil = new Perfil(id_perfil, "Perfil teste", id_cargo) { cargo = cargo };
            var cuidador = new Cuidador(id_cuidador, "Cuidador teste", $"{id_cuidador:D11}",
                $"{id_cuidador}@teste.local", "senha-teste", id_perfil)
            {
                Perfil = perfil
            };
            var idoso = new Idoso(id_idoso, "Idoso teste", $"{id_idoso:D11}", 1.70m, 70m,
                new DateOnly(1950, 1, 1), "Teste de integração", id_cuidador, cuidador);

            using (var scope = _factory.Services.CreateScope())
            {
                var dbContext = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                dbContext.Add(idoso);
                await dbContext.SaveChangesAsync();
            }

            var novaAlimentacao = new
            {
                Id_alimentacao = id_alimentacao,
                Nm_alimentacao = "Refeição de teste",
                Tp_alimentacao = TipoAlimentacao.almoco,
                Dt_consumo = new DateOnly(2026, 11, 17),
                Hr_consumo = new TimeOnly(12, 0),
                Vlr_caloria = 450m,
                Ds_preparacao = "Preparação de teste",
                Id_idoso = id_idoso
            };

            // Act
            var response = await _client.PostAsJsonAsync("api/Alimentacao/alimentacao/criar", novaAlimentacao);

            // Assert
            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi criada a alimentação: {erro}");
            }

            Assert.Equal(HttpStatusCode.Created, response.StatusCode);

            var alimentacaoCriada = await response.Content.ReadFromJsonAsync<Alimentacao>();

            Assert.NotNull(alimentacaoCriada);
            Assert.Equal(id_alimentacao, alimentacaoCriada.Id_alimentacao);
            Assert.Equal(novaAlimentacao.Nm_alimentacao, alimentacaoCriada.Nm_alimentacao);
            Assert.Equal(id_idoso, alimentacaoCriada.Id_idoso);
        }

        [Fact]
        public async Task UpdateAlimentacao_DadosValidos_RetornaSucesso()
        {
            // Arrange
            var id_cargo = Random.Shared.Next(100000, int.MaxValue);
            var id_perfil = Random.Shared.Next(100000, int.MaxValue);
            var id_cuidador = Random.Shared.Next(100000, int.MaxValue);
            var id_idoso = Random.Shared.Next(100000, int.MaxValue);
            var id_alimentacao = Random.Shared.Next(100000, int.MaxValue);

            var cargo = new Cargo(id_cargo, "Cargo teste", Permissao.N);
            var perfil = new Perfil(id_perfil, "Perfil teste", id_cargo) { cargo = cargo };
            var cuidador = new Cuidador(id_cuidador, "Cuidador teste", $"{id_cuidador:D11}",
                $"{id_cuidador}@teste.local", "senha-teste", id_perfil)
            {
                Perfil = perfil
            };
            var idoso = new Idoso(id_idoso, "Idoso teste", $"{id_idoso:D11}", 1.70m, 70m,
                new DateOnly(1950, 1, 1), "Teste de integração", id_cuidador, cuidador);
            var alimentacaoExistente = new Alimentacao(id_alimentacao, "Refeição original",
                TipoAlimentacao.almoco, new DateOnly(2026, 11, 17), new TimeOnly(12, 0), 450m,
                "Preparação original", id_idoso);

            using (var scope = _factory.Services.CreateScope())
            {
                var dbContext = scope.ServiceProvider.GetRequiredService<AppDbContext>();
                dbContext.Add(idoso);
                dbContext.Add(alimentacaoExistente);
                await dbContext.SaveChangesAsync();
            }

            var alimentacaoAtualizada = new
            {
                Id_alimentacao = id_alimentacao,
                Nm_alimentacao = "Refeição atualizada",
                Tp_alimentacao = TipoAlimentacao.jantar,
                Dt_consumo = new DateOnly(2026, 11, 18),
                Hr_consumo = new TimeOnly(19, 0),
                Vlr_caloria = 500m,
                Ds_preparacao = "Preparação atualizada",
                Id_idoso = id_idoso
            };

            // Act
            var response = await _client.PutAsJsonAsync(
                $"api/Alimentacao/alimentacao/atualiza/{id_alimentacao}", alimentacaoAtualizada);

            // Assert
            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi atualizada a alimentação: {erro}");
            }

            response.EnsureSuccessStatusCode();

            Assert.Equal(HttpStatusCode.OK, response.StatusCode);

            var alimentacao = await response.Content.ReadFromJsonAsync<Alimentacao>();

            Assert.NotNull(alimentacao);
            Assert.Equal(id_alimentacao, alimentacao.Id_alimentacao);
            Assert.Equal(alimentacaoAtualizada.Nm_alimentacao, alimentacao.Nm_alimentacao);
        }

