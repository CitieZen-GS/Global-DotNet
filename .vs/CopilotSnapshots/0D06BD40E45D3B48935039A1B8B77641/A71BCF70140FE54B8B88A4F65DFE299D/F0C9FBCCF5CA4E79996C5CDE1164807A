using System.Net;
using System.Net.Http.Json;
using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Enums;
using Ajudante_Familiar_Global.Infrastruture.Data;
using Ajudante_Familiar_Global.integrationTests.FactoryFixture;
using Microsoft.Extensions.DependencyInjection;
using Xunit;
using Assert = Xunit.Assert;

namespace Ajudante_Familiar_Global.integrationTests.Integration
{
    [Collection("ApiCollection")]
    public class AlimentacaoControllerIntegrationTests
    {
        private readonly ApiFactoryFixture _factory;
        private readonly HttpClient _client;

        public AlimentacaoControllerIntegrationTests(ApiFactoryFixture factory)
        {
            _factory = factory;
            _client = factory.CreateClient();
        }

        [Fact]
        public async Task CreateAlimentacao_DadosValidos_RetornaCreated()
        {
            var idIdoso = await CriarIdosoDeTesteAsync();
            var alimentacao = NovaAlimentacao(idIdoso);

            using var response = await _client.PostAsJsonAsync("api/Alimentacao/alimentacao/criar", alimentacao);

            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi criada a alimentação: {erro}");
            }

            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
            var criada = await response.Content.ReadFromJsonAsync<Alimentacao>();

            Assert.NotNull(criada);
            Assert.Equal(alimentacao.Id_alimentacao, criada.Id_alimentacao);
            Assert.Equal(alimentacao.Nm_alimentacao, criada.Nm_alimentacao);
            Assert.Equal(idIdoso, criada.Id_idoso);
        }

        [Fact]
        public async Task UpdateAlimentacao_DadosValidos_RetornaOk()
        {
            var idIdoso = await CriarIdosoDeTesteAsync();
            var alimentacaoCriada = await CriarAlimentacaoAsync(idIdoso);
            var alimentacaoAtualizada = NovaAlimentacao(idIdoso, alimentacaoCriada.Id_alimentacao, "Almoço atualizado");

            using var response = await _client.PutAsJsonAsync(
                $"api/Alimentacao/alimentacao/atualiza/{alimentacaoCriada.Id_alimentacao}",
                alimentacaoAtualizada);

            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi atualizada a alimentação: {erro}");
            }

            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var atualizada = await response.Content.ReadFromJsonAsync<Alimentacao>();

            Assert.NotNull(atualizada);
            Assert.Equal(alimentacaoCriada.Id_alimentacao, atualizada.Id_alimentacao);
            Assert.Equal("Almoço atualizado", atualizada.Nm_alimentacao);
        }

        [Fact]
        public async Task GetAlimentacao_IdExistente_RetornaOk()
        {
            var idIdoso = await CriarIdosoDeTesteAsync();
            var alimentacaoCriada = await CriarAlimentacaoAsync(idIdoso);

            using var response = await _client.GetAsync(
                $"api/Alimentacao/alimentacao/{alimentacaoCriada.Id_alimentacao}");

            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var alimentacao = await response.Content.ReadFromJsonAsync<Alimentacao>();

            Assert.NotNull(alimentacao);
            Assert.Equal(alimentacaoCriada.Id_alimentacao, alimentacao.Id_alimentacao);
            Assert.Equal(alimentacaoCriada.Nm_alimentacao, alimentacao.Nm_alimentacao);
        }

        [Fact]
        public async Task GetAllAlimentacao_RetornaOkComAlimentacaoCriada()
        {
            var idIdoso = await CriarIdosoDeTesteAsync();
            var alimentacaoCriada = await CriarAlimentacaoAsync(idIdoso);

            using var response = await _client.GetAsync("api/Alimentacao/alimentacao");

            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var alimentacoes = await response.Content.ReadFromJsonAsync<List<Alimentacao>>();

            Assert.NotNull(alimentacoes);
            Assert.Contains(alimentacoes, item => item.Id_alimentacao == alimentacaoCriada.Id_alimentacao);
        }

        [Fact]
        public async Task DeleteAlimentacao_IdExistente_RetornaNoContent()
        {
            var idIdoso = await CriarIdosoDeTesteAsync();
            var alimentacaoCriada = await CriarAlimentacaoAsync(idIdoso);

            using var response = await _client.DeleteAsync(
                $"api/Alimentacao/alimentacao/deleta/{alimentacaoCriada.Id_alimentacao}");

            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi deletada a alimentação: {erro}");
            }

            Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);

            using var consulta = await _client.GetAsync(
                $"api/Alimentacao/alimentacao/{alimentacaoCriada.Id_alimentacao}");
            Assert.Equal(HttpStatusCode.NotFound, consulta.StatusCode);
        }

        private async Task<Alimentacao> CriarAlimentacaoAsync(int idIdoso)
        {
            var alimentacao = NovaAlimentacao(idIdoso);
            using var response = await _client.PostAsJsonAsync("api/Alimentacao/alimentacao/criar", alimentacao);

            if (!response.IsSuccessStatusCode)
            {
                var erro = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi criada a alimentação de apoio: {erro}");
            }

            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
            var criada = await response.Content.ReadFromJsonAsync<Alimentacao>();
            Assert.NotNull(criada);
            return criada;
        }

        private async Task<int> CriarIdosoDeTesteAsync()
        {
            var cargoId = NovoId();
            var perfilId = NovoId();
            var cuidadorId = NovoId();
            var idosoId = NovoId();

            var cargo = new Cargo(cargoId, "Cargo teste", Permissao.N);
            var perfil = new Perfil(perfilId, "Perfil teste", cargoId) { cargo = cargo };
            var cuidador = new Cuidador(cuidadorId, "Cuidador teste", $"{cuidadorId:D11}",
                $"{cuidadorId}@teste.local", "senha-teste", perfilId)
            {
                Perfil = perfil
            };
            var idoso = new Idoso(idosoId, "Idoso teste", $"{idosoId:D11}", 1.70m, 70m,
                new DateOnly(1950, 1, 1), "Teste de integração", cuidadorId, cuidador);

            using var scope = _factory.Services.CreateScope();
            var dbContext = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            dbContext.Add(idoso);
            await dbContext.SaveChangesAsync();

            return idosoId;
        }

        private static Alimentacao NovaAlimentacao(int idIdoso, int? idAlimentacao = null,
            string nome = "Refeição de teste")
        {
            return new Alimentacao(
                idAlimentacao ?? NovoId(),
                nome,
                TipoAlimentacao.almoco,
                new DateOnly(2026, 11, 17),
                new TimeOnly(12, 0),
                450m,
                "Preparação de teste",
                idIdoso);
        }

        private static int NovoId() => Random.Shared.Next(1_000_000, int.MaxValue);
    }
}
