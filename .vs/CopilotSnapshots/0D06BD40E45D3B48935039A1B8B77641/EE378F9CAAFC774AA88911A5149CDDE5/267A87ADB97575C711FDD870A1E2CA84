using Ajudante_Familiar_Global.Controllers;
using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Interfaces.IService;
using Ajudante_Familiar_Global.Infrastruture.Data;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Routing;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using Moq;

namespace Ajudante_Familiar_Global.UnitTests.Controllers;

public class PerfilControllerTests
{
    private readonly Mock<IPerfilService> _perfil_ServiceMock;
    private readonly PerfilController _controller;
    private readonly ILogger<PerfilController> _logger;
    private readonly AppDbContext _context;

    public PerfilControllerTests()
    {
        _perfil_ServiceMock = new Mock<IPerfilService>();
        var loggMock = new Mock<ILogger<PerfilController>>();

        _logger = loggMock.Object;

        var options = new DbContextOptionsBuilder<AppDbContext>()
            .UseInMemoryDatabase(Guid.NewGuid().ToString())
            .Options;

        _context = new AppDbContext(options);

        _controller = new PerfilController(_perfil_ServiceMock.Object, _logger);

        _controller.ControllerContext = new ControllerContext
        {
            HttpContext = new DefaultHttpContext()
        };

        var urlHelper = new Mock<IUrlHelper>();
        urlHelper.Setup(helper => helper.Link(It.IsAny<string?>(), It.IsAny<object?>()))
                .Returns((string? routeName, object? _) => $"https://localhost/{routeName}");
        _controller.Url = urlHelper.Object;
    }

    //Criação
    [Fact]
    public async Task Create_Perfil_RetornaCreated()
    {
        // Arrange
        var perfil = new Perfil(1, "Perfil teste", 1);

        _perfil_ServiceMock.Setup(service => service.CreatePerfilAsync(perfil)).ReturnsAsync(perfil);

        // Act
        var resultado = await _controller.PostPerfil(perfil);

        // Assert
        var createdResult = Assert.IsType<CreatedAtActionResult>(resultado.Result);
        var perfilRetornado = Assert.IsType<Perfil>(createdResult.Value);
        Assert.NotNull(perfilRetornado);
        Assert.Equal(perfil.id_perfil, perfilRetornado.id_perfil);
    }

    //Atualização
    [Fact]
    public async Task Update_Perfil_RetornaOk()
    {
        // Arrange
        var id_perfil = 1;
        var perfil = new Perfil(id_perfil, "Perfil atualizado", 1);

        _perfil_ServiceMock.Setup(service => service.UpdatePerfilAsync(id_perfil, perfil)).ReturnsAsync(perfil);

        //Act
        var atualizacaoRealizada = await _controller.PutPerfil(id_perfil, perfil);

        //Assert
        var okResultado = Assert.IsType<OkObjectResult>(atualizacaoRealizada.Result);
        var retornoPerfil = Assert.IsType<Perfil>(okResultado.Value);
        //Dados atualizados
        Assert.Equal(perfil.id_perfil, retornoPerfil.id_perfil);
        Assert.Equal(perfil.nm_perfil, retornoPerfil.nm_perfil);
        Assert.Equal(perfil.id_cargo, retornoPerfil.id_cargo);
    }

    [Fact]
    public async Task GetAll_Perfil_RetornandoOk()
    {
        // Arrange
        var list = new List<Perfil> { new Perfil(1, "Perfil teste", 1) };

        _perfil_ServiceMock.Setup(service => service.GetAllPerfilAsync()).ReturnsAsync(list);

        // Act
        var resultado = await _controller.GetAllPerfil();

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedList = Assert.IsType<List<Perfil>>(okResult.Value);
        Assert.NotNull(returnedList);
        Assert.Single(returnedList);
        Assert.Equal(1, returnedList[0].id_perfil);
    }

    [Fact]
    public async Task GetId_Perfil_RetornandoOk()
    {
        // Arrange
        var id_perfil = 1;
        var perfil = new Perfil(id_perfil, "Perfil teste", 1);

        _perfil_ServiceMock.Setup(service => service.GetPerfilAsync(id_perfil)).ReturnsAsync(perfil);

        // Act
        var resultado = await _controller.GetPerfil(id_perfil);

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedPerfil = Assert.IsType<Perfil>(okResult.Value);
        Assert.NotNull(returnedPerfil);
        Assert.Equal(id_perfil, returnedPerfil.id_perfil);
    }

    [Fact]
    public async Task Deleta_Perfil()
    {
        // Arrange
        var id_perfil = 1;

        _perfil_ServiceMock.Setup(service => service.DeletePerfilAsync(id_perfil)).ReturnsAsync(new Perfil(id_perfil, "Perfil teste", 1));

        //Act
        var resultado = await _controller.DeletePerfil(id_perfil);

        //Assert
        Assert.IsType<NoContentResult>(resultado);
    }
}
