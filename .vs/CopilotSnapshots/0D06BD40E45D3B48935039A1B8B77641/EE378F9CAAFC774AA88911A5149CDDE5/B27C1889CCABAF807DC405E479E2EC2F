using Ajudante_Familiar_Global.Controllers;
using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Enums;
using Ajudante_Familiar_Global.Domain.Interfaces.IService;
using Ajudante_Familiar_Global.Infrastruture.Data;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Routing;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using Moq;

namespace Ajudante_Familiar_Global.UnitTests.Controllers;

public class Lembrete_ConsultaControllerTests
{
    private readonly Mock<ILembrete_ConsultaService> _lembrete_Consulta_ServiceMock;
    private readonly Lembrete_ConsultaController _controller;
    private readonly ILogger<Lembrete_ConsultaController> _logger;
    private readonly AppDbContext _context;

    public Lembrete_ConsultaControllerTests()
    {
        _lembrete_Consulta_ServiceMock = new Mock<ILembrete_ConsultaService>();
        var loggMock = new Mock<ILogger<Lembrete_ConsultaController>>();

        _logger = loggMock.Object;

        var options = new DbContextOptionsBuilder<AppDbContext>()
            .UseInMemoryDatabase(Guid.NewGuid().ToString())
            .Options;

        _context = new AppDbContext(options);

        _controller = new Lembrete_ConsultaController(_lembrete_Consulta_ServiceMock.Object, _logger);

        _controller.ControllerContext = new ControllerContext
        {
            HttpContext = new DefaultHttpContext()
        };

        var urlHelper = new Mock<IUrlHelper>();
        urlHelper.Setup(helper => helper.Link(It.IsAny<string?>(), It.IsAny<object?>()))
                .Returns((string? routeName, object? _) => $"https://localhost/{routeName}");
        _controller.Url = urlHelper.Object;
    }

    //Criação
    [Fact]
    public async Task Create_LembreteConsulta_RetornaCreated()
    {
        // Arrange
        var lembrete = new Lembrete_Consulta(1, "Consulta teste", "Médico teste",
            new DateTime(2026, 8, 9), new DateTime(2026, 8, 9, 9, 0, 0), "Descrição teste", Status.Pendente, 1, null!);
        _lembrete_Consulta_ServiceMock.Setup(service => service.CreateLembrete_ConsultaAsync(lembrete)).ReturnsAsync(lembrete);

        // Act
        var resultado = await _controller.PostLembrete_Consulta(lembrete);

        // Assert
        var createdResult = Assert.IsType<CreatedAtActionResult>(resultado.Result);
        var lembreteRetornado = Assert.IsType<Lembrete_Consulta>(createdResult.Value);
        Assert.NotNull(lembreteRetornado);
        Assert.Equal(lembrete.id_lembrete_consulta, lembreteRetornado.id_lembrete_consulta);
    }

    //Atualização
    [Fact]
    public async Task Update_LembreteConsulta_RetornaOk()
    {
        // Arrange
        var id_lembrete_consulta = 1;
        var lembrete = new Lembrete_Consulta(id_lembrete_consulta, "Consulta atualizada", "Médico teste",
            new DateTime(2026, 8, 10), new DateTime(2026, 8, 10, 10, 0, 0), "Descrição atualizada", Status.Realizado, 1, null!);
        _lembrete_Consulta_ServiceMock.Setup(service => service.UpdateLembrete_ConsultaAsync(id_lembrete_consulta, lembrete))
            .ReturnsAsync(lembrete);

        //Act
        var atualizacaoRealizada = await _controller.PutLembrete_Consulta(id_lembrete_consulta, lembrete);

        //Assert
        var okResultado = Assert.IsType<OkObjectResult>(atualizacaoRealizada.Result);
        var retornoLembrete = Assert.IsType<Lembrete_Consulta>(okResultado.Value);
        //Dados atualizados
        Assert.Equal(lembrete.id_lembrete_consulta, retornoLembrete.id_lembrete_consulta);
        Assert.Equal(lembrete.Ds_titulo_lembrente_consulta, retornoLembrete.Ds_titulo_lembrente_consulta);
        Assert.Equal(lembrete.Nm_consulta_medico, retornoLembrete.Nm_consulta_medico);
        Assert.Equal(lembrete.Dt_consulta, retornoLembrete.Dt_consulta);
        Assert.Equal(lembrete.Hr_consulta, retornoLembrete.Hr_consulta);
        Assert.Equal(lembrete.Ds_consulta, retornoLembrete.Ds_consulta);
        Assert.Equal(lembrete.St_consulta, retornoLembrete.St_consulta);
        Assert.Equal(lembrete.Id_idoso, retornoLembrete.Id_idoso);
    }

    [Fact]
    public async Task GetAll_LembreteConsulta_RetornandoOk()
    {
        // Arrange
        var list = new List<Lembrete_Consulta>
        {
            new Lembrete_Consulta(1, "Consulta teste", "Médico teste", new DateTime(2026, 8, 9),
                new DateTime(2026, 8, 9, 9, 0, 0), "Descrição teste", Status.Pendente, 1, null!)
        };
        _lembrete_Consulta_ServiceMock.Setup(service => service.GetAllLembrete_ConsultaAsync()).ReturnsAsync(list);

        // Act
        var resultado = await _controller.GetAllLembrete_Consulta();

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedList = Assert.IsType<List<Lembrete_Consulta>>(okResult.Value);
        Assert.NotNull(returnedList);
        Assert.Single(returnedList);
        Assert.Equal(1, returnedList[0].id_lembrete_consulta);
    }

    [Fact]
    public async Task GetId_LembreteConsulta_RetornandoOk()
    {
        // Arrange
        var id_lembrete_consulta = 1;
        var lembrete = new Lembrete_Consulta(id_lembrete_consulta, "Consulta teste", "Médico teste",
            new DateTime(2026, 8, 9), new DateTime(2026, 8, 9, 9, 0, 0), "Descrição teste", Status.Pendente, 1, null!);
        _lembrete_Consulta_ServiceMock.Setup(service => service.GetLembrete_ConsultaAsync(id_lembrete_consulta))
            .ReturnsAsync(lembrete);

        // Act
        var resultado = await _controller.GetLembrete_Consulta(id_lembrete_consulta);

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedLembrete = Assert.IsType<Lembrete_Consulta>(okResult.Value);
        Assert.NotNull(returnedLembrete);
        Assert.Equal(id_lembrete_consulta, returnedLembrete.id_lembrete_consulta);
    }

    [Fact]
    public async Task Deleta_LembreteConsulta()
    {
        // Arrange
        var id_lembrete_consulta = 1;
        _lembrete_Consulta_ServiceMock.Setup(service => service.DeleteLembrete_ConsultaAsync(id_lembrete_consulta))
            .ReturnsAsync(new Lembrete_Consulta(id_lembrete_consulta, "Consulta teste", "Médico teste",
                new DateTime(2026, 8, 9), new DateTime(2026, 8, 9, 9, 0, 0), "Descrição teste", Status.Pendente, 1, null!));

        //Act
        var resultado = await _controller.DeleteLembrete_Consulta(id_lembrete_consulta);

        //Assert
        Assert.IsType<NoContentResult>(resultado);
    }
}
