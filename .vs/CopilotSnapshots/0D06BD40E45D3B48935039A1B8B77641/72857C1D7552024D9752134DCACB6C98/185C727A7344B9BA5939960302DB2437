using Ajudante_Familiar_Global.integrationTests.FactoryFixture;
using Ajudante_Familiar_Global.Domain.Entities;
using System;
using System.Net;
using System.Net.Http.Json;
using Xunit;
using Assert = Xunit.Assert;

namespace Ajudante_Familiar_Global.integrationTests.Integration
{
    //Atenção!!! Tanto o create quanto o update precisam ter cuidado com os dados que serão adicionados, porque, se não, pode dar erro.
    //Recomendação faz um a cada vez, não faz eles tudo junto
    [Collection("ApiCollection")]
    public class MedicamentosControllerIntegrationTests
    {
        private readonly HttpClient _client;

        public MedicamentosControllerIntegrationTests(ApiFactoryFixture factory)
        {
            _client = factory.CreateClient();
        }

        [Fact]
        public async Task CriarMedicamentos_DadosValidos_RetornaOk()
        {
            // Arrange
            var id_medicamentos = Random.Shared.Next(1, 100);
            var novoMedicamento = new { id_medicamentos = id_medicamentos, Nm_medicamentos = "Medicamento teste", Via_administracao = "Oral", Vl_frquencia = "1 vez ao dia", Ds_instrucao_uso = "Após refeição", Dt_medicamento = new DateTime(2026, 8, 9), Hr_medicamento = new DateTime(2026, 8, 9, 9, 0, 0), Id_idoso = 1 };

            // Act
            var response = await _client.PostAsJsonAsync("api/Medicamentos/medicamentos/criar", novoMedicamento);

            // Assert
            var erro = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) Assert.Fail($"Não foi criado por: {erro}");
            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.Created, response.StatusCode);
            var medicamentoCriado = await response.Content.ReadFromJsonAsync<Medicamentos>();
            Assert.NotNull(medicamentoCriado);
            Assert.Equal(id_medicamentos, medicamentoCriado.id_medicamentos);
        }

        [Fact]
        public async Task AtualizarMedicamentos_DadosValidos_RetornaSucesso()
        {
            // Arrange
            var id_medicamentos = 6;
            var medicamentoAtualizado = new { id_medicamentos = id_medicamentos, Nm_medicamentos = "Medicamento atualizado", Via_administracao = "Oral", Vl_frquencia = "2 vezes ao dia", Ds_instrucao_uso = "Após refeição", Dt_medicamento = new DateTime(2026, 10, 12), Hr_medicamento = new DateTime(2026, 10, 12, 10, 0, 0), Id_idoso = 1 };

            // Act
            var response = await _client.PutAsJsonAsync($"api/Medicamentos/medicamentos/atualiza/{id_medicamentos}", medicamentoAtualizado);

            // Assert
            var erro = await response.Content.ReadAsStringAsync();
            if (!response.IsSuccessStatusCode) Assert.Fail($"Não foi atualizado por: {erro}");
            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
        }

        [Fact]
        public async Task GetMedicamentos_dados_RetornaOk()
        {
            // Arrange
            var id_medicamentos = 6;

            // Act
            var response = await _client.GetAsync($"api/Medicamentos/medicamentos/{id_medicamentos}");

            // Assert
            if (response.StatusCode == HttpStatusCode.NotFound) Assert.Fail("Medicamento não encontrado");
            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var medicamento = await response.Content.ReadFromJsonAsync<Medicamentos>();
            Assert.NotNull(medicamento);
            Assert.Equal(id_medicamentos, medicamento.id_medicamentos);
        }

        [Fact]
        public async Task GetAllMedicamentos_dados_RetornarOk()
        {
            //Act
            var response = await _client.GetAsync("api/Medicamentos/medicamentos");

            //Assert
            response.EnsureSuccessStatusCode();
            Assert.Equal(HttpStatusCode.OK, response.StatusCode);
            var medicamentos = await response.Content.ReadFromJsonAsync<List<Medicamentos>>();
            Assert.NotNull(medicamentos);
        }

        [Fact]
        public async Task DeleteMedicamentos_dados_RetornaOk()
        {
            // Arrange
            var id_medicamentos = 55;

            // Act
            var response = await _client.DeleteAsync($"api/Medicamentos/medicamentos/deleta/{id_medicamentos}");

            // Assert
            if (!response.IsSuccessStatusCode)
            {
                var erroAchado = await response.Content.ReadAsStringAsync();
                Assert.Fail($"Não foi deletado pelo motivo: {erroAchado}");
            }
            Assert.Equal(HttpStatusCode.NoContent, response.StatusCode);
        }
    }
}
