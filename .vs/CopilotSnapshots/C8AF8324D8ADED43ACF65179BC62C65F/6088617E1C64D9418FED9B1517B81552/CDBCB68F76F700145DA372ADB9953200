using Ajudante_Familiar_Global.Controllers;
using Ajudante_Familiar_Global.Domain.Entities;
using Ajudante_Familiar_Global.Domain.Interfaces.IService;
using Ajudante_Familiar_Global.Infrastruture.Data;
using Microsoft.AspNetCore.Http;
using Microsoft.AspNetCore.Mvc;
using Microsoft.AspNetCore.Mvc.Routing;
using Microsoft.EntityFrameworkCore;
using Microsoft.Extensions.Logging;
using Moq;

namespace Ajudante_Familiar_Global.UnitTests.Controllers;

public class Consulta_MedicamentoControllerTests
{
    private readonly Mock<IConsulta_MedicamentoService> _consulta_Medicamento_ServiceMock;
    private readonly Consulta_MedicamentoController _controller;
    private readonly ILogger<Consulta_MedicamentoController> _logger;
    private readonly AppDbContext _context;

    public Consulta_MedicamentoControllerTests()
    {
        _consulta_Medicamento_ServiceMock = new Mock<IConsulta_MedicamentoService>();
        var loggMock = new Mock<ILogger<Consulta_MedicamentoController>>();

        _logger = loggMock.Object;

        var options = new DbContextOptionsBuilder<AppDbContext>()
            .UseInMemoryDatabase(Guid.NewGuid().ToString())
            .Options;

        _context = new AppDbContext(options);

        _controller = new Consulta_MedicamentoController(_consulta_Medicamento_ServiceMock.Object, _logger);

        _controller.ControllerContext = new ControllerContext
        {
            HttpContext = new DefaultHttpContext()
        };

        var urlHelper = new Mock<IUrlHelper>();
        urlHelper.Setup(helper => helper.Link(It.IsAny<string?>(), It.IsAny<object?>()))
                .Returns((string? routeName, object? _) => $"https://localhost/{routeName}");
        _controller.Url = urlHelper.Object;
    }

    //Criação
    [Fact]
    public async Task Create_ConsultaMedicamento_RetornaCreated()
    {
        // Arrange
        var consultaMedicamento = new Consulta_Medicamento(1, 1, new Lembrete_Consulta(), 1, new Medicamentos());

        _consulta_Medicamento_ServiceMock.Setup(service => service.CreateConsulta_MedicamentoAsync(consultaMedicamento))
            .ReturnsAsync(consultaMedicamento);

        // Act
        var resultado = await _controller.PostConsulta_Medicamento(consultaMedicamento);

        // Assert
        var createdResult = Assert.IsType<CreatedAtActionResult>(resultado.Result);
        var consultaRetornada = Assert.IsType<Consulta_Medicamento>(createdResult.Value);
        Assert.NotNull(consultaRetornada);
        Assert.Equal(consultaMedicamento.id_consulta_medicamento, consultaRetornada.id_consulta_medicamento);
    }

    //Atualização
    [Fact]
    public async Task Update_ConsultaMedicamento_RetornaOk()
    {
        // Arrange
        var id_consulta_medicamento = 1;
        var consultaMedicamento = new Consulta_Medicamento(id_consulta_medicamento, 1,
            new Lembrete_Consulta(), 1, new Medicamentos());

        _consulta_Medicamento_ServiceMock.Setup(service => service.UpdateConsulta_MedicamentoAsync(
            id_consulta_medicamento, consultaMedicamento)).ReturnsAsync(consultaMedicamento);

        //Act
        var atualizacaoRealizada = await _controller.PutConsulta_Medicamento(id_consulta_medicamento, consultaMedicamento);

        //Assert
        var okResultado = Assert.IsType<OkObjectResult>(atualizacaoRealizada.Result);
        var retornoConsulta = Assert.IsType<Consulta_Medicamento>(okResultado.Value);
        //Dados atualizados
        Assert.Equal(consultaMedicamento.id_consulta_medicamento, retornoConsulta.id_consulta_medicamento);
        Assert.Equal(consultaMedicamento.id_lembrete_consulta, retornoConsulta.id_lembrete_consulta);
        Assert.Equal(consultaMedicamento.id_Medicamentos, retornoConsulta.id_Medicamentos);
    }

    [Fact]
    public async Task GetAll_ConsultaMedicamento_RetornandoOk()
    {
        // Arrange
        var list = new List<Consulta_Medicamento>
        {
            new Consulta_Medicamento(1, 1, new Lembrete_Consulta(), 1, new Medicamentos())
        };

        _consulta_Medicamento_ServiceMock.Setup(service => service.GetAllConsulta_MedicamentoAsync())
            .ReturnsAsync(list);

        // Act
        var resultado = await _controller.GetAllConsulta_Medicamento();

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedList = Assert.IsType<List<Consulta_Medicamento>>(okResult.Value);

        Assert.NotNull(returnedList);
        Assert.Single(returnedList);
        Assert.Equal(1, returnedList[0].id_consulta_medicamento);
    }

    [Fact]
    public async Task GetId_ConsultaMedicamento_RetornandoOk()
    {
        // Arrange
        var id_consulta_medicamento = 1;
        var consultaMedicamento = new Consulta_Medicamento(id_consulta_medicamento, 1,
            new Lembrete_Consulta(), 1, new Medicamentos());

        _consulta_Medicamento_ServiceMock.Setup(service => service.GetConsulta_MedicamentoAsync(id_consulta_medicamento))
            .ReturnsAsync(consultaMedicamento);

        // Act
        var resultado = await _controller.GetConsulta_Medicamento(id_consulta_medicamento);

        // Assert
        var okResult = Assert.IsType<OkObjectResult>(resultado.Result);
        var returnedConsulta = Assert.IsType<Consulta_Medicamento>(okResult.Value);

        Assert.NotNull(returnedConsulta);
        Assert.Equal(id_consulta_medicamento, returnedConsulta.id_consulta_medicamento);
    }

    [Fact]
    public async Task Deleta_ConsultaMedicamento()
    {
        // Arrange
        var id_consulta_medicamento = 1;
        var consultaMedicamento = new Consulta_Medicamento(id_consulta_medicamento, 1,
            new Lembrete_Consulta(), 1, new Medicamentos());

        _consulta_Medicamento_ServiceMock.Setup(service => service.DeleteConsulta_MedicamentoAsync(id_consulta_medicamento))
            .ReturnsAsync(consultaMedicamento);

        //Act
        var resultado = await _controller.DeleteConsulta_Medicamento(id_consulta_medicamento);

        //Assert
        Assert.IsType<NoContentResult>(resultado);
    }
}
